<?xml version="1.0" encoding="utf-8"?>
<!-- Two columns, so the test fields stay in the top half of the screen: the keyboard panel floats
     over the bottom corner and apps are not resized for it. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF202124">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="27dp">

        <!-- Setup and settings -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFE8EAED"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FF9AA0A6"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button

                    android:textAllCaps="false"
                    android:id="@+id/btn_enable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_enable" />

                <Button

                    android:textAllCaps="false"
                    android:id="@+id/btn_pick"
                    android:nextFocusRight="@id/test_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/setup_pick" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/setup_settings_label"
                android:textColor="#FFE8EAED"
                android:textSize="18sp" />

            <Button

                android:textAllCaps="false"
                android:id="@+id/btn_layout"
                android:nextFocusRight="@id/test_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <Button

                android:textAllCaps="false"
                android:id="@+id/btn_timeout"
                android:nextFocusRight="@id/test_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button

                android:textAllCaps="false"
                android:id="@+id/btn_position"
                android:nextFocusRight="@id/test_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Test fields -->
        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_test_label"
                android:textColor="#FFE8EAED"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/test_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_test_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapSentences" />

            <EditText
                android:id="@+id/test_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text" />

            <EditText
                android:id="@+id/test_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_password_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/test_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_number_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
